{
  // PPP Calculator — static assets via Workers
  // Public: https://ppp.tanishqnalloju.com
  "name": "ppp-calculator",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "ppp.tanishqnalloju.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
